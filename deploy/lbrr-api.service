[Unit]
Description=logic-bs-roformer-rs HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/lbrr-api/repo
Environment=PYTHONUNBUFFERED=1
Environment=LBRR_BIN=/opt/lbrr/bin/lbrr
Environment=LBRR_MODEL_DIR=/opt/lbrr/bin/assets
Environment=LBRR_API_HOST=0.0.0.0
Environment=LBRR_API_PORT=10722
Environment=LBRR_API_TEMP_DIR=/var/tmp/lbrr-api
Environment=LBRR_API_CONCURRENCY=1
EnvironmentFile=-/etc/lbrr-api.env
ExecStart=/opt/lbrr-api/venv/bin/python -m api.lbrr_api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
